# Copy to .env and adjust. Never commit .env.

POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# Host ports (container ports stay 5432 / 8000)
POSTGRES_PORT=5433
API_PORT=8001

# Used by the API when running on the host (outside Docker).
# Inside Docker Compose, the API connects to host "db" instead.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5433/copilot

# LLM (optional). Without a key the copilot runs in offline mode: same retrieval and tools,
# but answers are cited evidence instead of generated text.
# Option A: Anthropic Claude
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Option B: any OpenAI-compatible API (set LLM_PROVIDER=openai and comment out option A's model)
#   Gemini (free tier, key from aistudio.google.com):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-3-flash-preview
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite  # free quota is per model
# LLM_MAX_RETRIES=1
# LLM_EFFORT=low
#   Ollama (local, free). Tested on a 12 GB RTX 3060: qwen3.5:9b beat gemma4:12b and
#   qwen3:14b on the demo scenarios. Start Ollama with OLLAMA_CONTEXT_LENGTH=16384 (the
#   default 4096 truncates the documents). Use localhost:11434 when the API runs on the host.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:9b
# LLM_EFFORT=none               # thinking off: 2-4x faster, and steadier tool use at this size
# LLM_SCHEMA_WITH_TOOLS=false   # Ollama's JSON-schema mode blocks tool calls
# LLM_TEMPERATURE=0.3           # Ollama's default (1.0) makes tool use erratic
# LLM_MAX_OUTPUT_TOKENS=2048    # stops a rare runaway generation early
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=1
#   Groq / OpenAI: their base URL (https://api.groq.com/openai/v1, https://api.openai.com/v1),
#   key, and model name.

# Retrieval tuning (defaults are justified in docs/rag-decisions.md)
# RETRIEVAL_MODE=hybrid_rerank
# RETRIEVAL_K=5
# MIN_RERANK_SCORE=-5.0
