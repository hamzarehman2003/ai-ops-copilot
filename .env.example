# Copy to .env and adjust. Never commit .env.

POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# Host ports (container ports stay 5432 / 8000)
POSTGRES_PORT=5433
API_PORT=8001

# Used by the API when running on the host (outside Docker).
# Inside Docker Compose, the API connects to host "db" instead.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5433/copilot

# LLM (optional). Without a key the copilot runs in offline mode: same retrieval and tools,
# but answers are cited evidence instead of generated text.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Retrieval tuning (defaults are justified in docs/rag-decisions.md)
# RETRIEVAL_MODE=hybrid_rerank
# RETRIEVAL_K=5
# MIN_RERANK_SCORE=-5.0
